// Prisma schema — SPEC-AUTH-001 M1 (Prisma 스키마 확장)
//
// Source of truth for the model shapes: design.md §2 (Prisma 스키마 개념 설계),
// cross-checked against plan.md §3.1. Do not diverge from design.md without
// updating design.md first (manager-develop is not the owner of SPEC body content).

// SPEC-CATALOG-002 M1 — `postgresqlExtensions` lets the schema declare the
// PostgreSQL extensions a migration must install. Without it the `extensions`
// field on the datasource below is ignored and pg_trgm never reaches the
// migration, leaving the GIN index on Product.name uncreatable.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm supplies the gin_trgm_ops operator class that makes a
  // leading-wildcard ILIKE indexable (SPEC-CATALOG-002 plan.md §2.3).
  extensions = [pg_trgm]
}

enum Role {
  customer
  admin
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String? // nullable — OAuth-only users have no password
  emailVerified Boolean        @default(false)
  role          Role           @default(customer)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  // SPEC-CART-001 M1 — back-relation only. Prisma requires the opposite side
  // of Cart.user to be declared here; no existing field above changes.
  // Modelled as a LIST even though @@unique([userId]) on Cart caps it at one,
  // because Prisma derives arity from the FK side's uniqueness, and a scalar
  // here would not compile against a nullable non-unique-typed back-reference.
  carts         Cart[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // e.g. "google" — extensible to other providers
  providerAccountId String // the provider's subject id (Google's `sub`)
  createdAt         DateTime @default(now())

  // Prevents account-collision / double-linking: one (provider, providerAccountId)
  // pair maps to exactly one OAuthAccount row (REQ-AUTH-017/018/019).
  @@unique([provider, providerAccountId])
}

// @MX:ANCHOR fan-in target — the shared session-issuance path (issueSession(),
// M2) and the refresh-rotation / reuse-detection / logout logic (M4) all read
// and write this model. Any schema change here has fan-out across M2/M4/M6.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String // SHA-256 (or equivalent) hash of the opaque token — plaintext is never stored
  familyId          String // groups a rotation chain; enables "revoke entire family" on reuse detection (REQ-AUTH-011)
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String? // set on rotation — points at the token that replaced this one
  userAgent         String? // optional — reserved for a future "active sessions" UI (plan.md §3.1)
  ip                String? // optional — reserved for a future "active sessions" UI (plan.md §3.1)
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ---------------------------------------------------------------------------
// SPEC-CATALOG-001 M1 — product catalog domain.
//
// Source of truth for these two model shapes: SPEC-CATALOG-001 plan.md §3
// (Prisma 스키마 확장). Do not diverge from plan.md without updating plan.md
// first (manager-develop is not the owner of SPEC body content).
// ---------------------------------------------------------------------------

// A product classification. Modelled as a TABLE rather than a Prisma enum
// (plan.md §2.1) so that a future admin SPEC can add or rename categories with
// a data change instead of a schema migration + deploy.
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique // the list API's `?category=` filter key (REQ-CATALOG-010)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// @MX:ANCHOR fan-in target — every catalog read path reaches this model:
// the list query (pagination + sort + category filter) and the detail query in
// src/features/catalog/repositories/product-repository.ts, and through them
// both public route handlers under src/app/api/products/.
// @MX:REASON a column or index change here changes the query plan for the two
// endpoints REQ-CATALOG-016 holds to a p95 300ms budget, so schema edits carry
// performance fan-out beyond their local correctness.
model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int // KRW minor-unit-free integer (plan.md §2.2) — not Decimal
  description String
  images      String[] // image URLs; array order is display order (plan.md §2.3)
  stock       Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // SPEC-CART-001 M1 — back-relation only; no existing field above changes.
  cartItems   CartItem[]

  @@index([categoryId]) // REQ-CATALOG-010 category filter
  @@index([createdAt]) // REQ-CATALOG-008 `newest` sort (the default)
  @@index([price]) // REQ-CATALOG-008 `price_asc` / `price_desc` sorts
  // SPEC-CATALOG-002 M1 — REQ-CATALOG-018 keyword search runs as
  // `name ILIKE '%term%'`. A B-tree index cannot serve a LEADING wildcard (it
  // can only seek a known prefix), so the three indexes above leave that scan
  // unaccelerated. A GIN index over trigrams can, which is what keeps a search
  // request inside REQ-CATALOG-016B's p95 300ms budget as the catalog grows.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_trgm_idx")
}

// ---------------------------------------------------------------------------
// SPEC-CART-001 M1 — cart domain.
//
// Source of truth for these two model shapes: SPEC-CART-001 plan.md §4. Do not
// diverge from plan.md without updating plan.md first (manager-develop is not
// the owner of SPEC body content).
// ---------------------------------------------------------------------------

// A cart belongs to EXACTLY ONE identity (REQ-CART-001): a member (`userId`)
// or a guest cookie (`guestId`). Both columns are nullable and the "exactly
// one" half is an APP-LEVEL invariant, not a DB CHECK constraint — plan.md
// §2.1 chose this over a polymorphic owner column (which forfeits the FK to
// User) and over split UserCart/GuestCart tables (which forces CartItem to
// point at two parents). The invariant is held by giving the repository only
// two construction paths, createUserCart() and createGuestCart(), so no code
// path exists that can fill both columns or neither.
//
// @MX:ANCHOR fan-in target — every cart read and write path reaches this
// model: identity resolution, the four public cart endpoints, and the
// login-time guest->member merge invoked from both auth success routes.
// @MX:REASON the ownership columns here are what separates one shopper's cart
// from another's, so a change to their nullability or uniqueness is an
// authorization boundary change, not a modelling detail.
model Cart {
  id        String     @id @default(cuid())
  // @unique on a NULLABLE column excludes NULLs from the uniqueness check
  // (standard Postgres), so these read as "at most one cart per member" and
  // "at most one cart per guest cookie" while still allowing many rows to
  // leave the other column NULL.
  userId    String?    @unique
  guestId   String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([guestId])
}

// One line of a cart. Carries NO price column: the cart always joins
// Product.price live (plan.md §2.4) because nothing has been promised to the
// shopper until checkout, and checkout owns its own price-confirmation
// mechanism.
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  // Cascade, deliberately UNLIKE Product -> Category's Restrict: a cart line
  // has no reason to outlive the product it points at, so a deleted product
  // simply leaves every cart (plan.md §4/§8).
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The conflict target REQ-CART-006's add-is-increment upsert relies on: one
  // row per (cart, product) is what makes "add the same product again" an
  // increment rather than a duplicate row.
  @@unique([cartId, productId])
  @@index([productId])
}
