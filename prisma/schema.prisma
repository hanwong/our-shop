// Prisma schema — SPEC-AUTH-001 M1 (Prisma 스키마 확장)
//
// Source of truth for the model shapes: design.md §2 (Prisma 스키마 개념 설계),
// cross-checked against plan.md §3.1. Do not diverge from design.md without
// updating design.md first (manager-develop is not the owner of SPEC body content).

// SPEC-CATALOG-002 M1 — `postgresqlExtensions` lets the schema declare the
// PostgreSQL extensions a migration must install. Without it the `extensions`
// field on the datasource below is ignored and pg_trgm never reaches the
// migration, leaving the GIN index on Product.name uncreatable.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm supplies the gin_trgm_ops operator class that makes a
  // leading-wildcard ILIKE indexable (SPEC-CATALOG-002 plan.md §2.3).
  extensions = [pg_trgm]
}

enum Role {
  customer
  admin
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String? // nullable — OAuth-only users have no password
  emailVerified Boolean        @default(false)
  role          Role           @default(customer)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  oauthAccounts OAuthAccount[]
  refreshTokens RefreshToken[]
  // SPEC-CART-001 M1 — back-relation only. Prisma requires the opposite side
  // of Cart.user to be declared here; no existing field above changes.
  // Modelled as a LIST even though @@unique([userId]) on Cart caps it at one,
  // because Prisma derives arity from the FK side's uniqueness, and a scalar
  // here would not compile against a nullable non-unique-typed back-reference.
  carts         Cart[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // e.g. "google" — extensible to other providers
  providerAccountId String // the provider's subject id (Google's `sub`)
  createdAt         DateTime @default(now())

  // Prevents account-collision / double-linking: one (provider, providerAccountId)
  // pair maps to exactly one OAuthAccount row (REQ-AUTH-017/018/019).
  @@unique([provider, providerAccountId])
}

// @MX:ANCHOR fan-in target — the shared session-issuance path (issueSession(),
// M2) and the refresh-rotation / reuse-detection / logout logic (M4) all read
// and write this model. Any schema change here has fan-out across M2/M4/M6.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String // SHA-256 (or equivalent) hash of the opaque token — plaintext is never stored
  familyId          String // groups a rotation chain; enables "revoke entire family" on reuse detection (REQ-AUTH-011)
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String? // set on rotation — points at the token that replaced this one
  userAgent         String? // optional — reserved for a future "active sessions" UI (plan.md §3.1)
  ip                String? // optional — reserved for a future "active sessions" UI (plan.md §3.1)
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ---------------------------------------------------------------------------
// SPEC-CATALOG-001 M1 — product catalog domain.
//
// Source of truth for these two model shapes: SPEC-CATALOG-001 plan.md §3
// (Prisma 스키마 확장). Do not diverge from plan.md without updating plan.md
// first (manager-develop is not the owner of SPEC body content).
// ---------------------------------------------------------------------------

// A product classification. Modelled as a TABLE rather than a Prisma enum
// (plan.md §2.1) so that a future admin SPEC can add or rename categories with
// a data change instead of a schema migration + deploy.
model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique // the list API's `?category=` filter key (REQ-CATALOG-010)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// @MX:ANCHOR fan-in target — every catalog read path reaches this model:
// the list query (pagination + sort + category filter) and the detail query in
// src/features/catalog/repositories/product-repository.ts, and through them
// both public route handlers under src/app/api/products/.
// @MX:REASON a column or index change here changes the query plan for the two
// endpoints REQ-CATALOG-016 holds to a p95 300ms budget, so schema edits carry
// performance fan-out beyond their local correctness.
model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int // KRW minor-unit-free integer (plan.md §2.2) — not Decimal
  description String
  images      String[] // image URLs; array order is display order (plan.md §2.3)
  stock       Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // SPEC-CART-001 M1 — back-relation only; no existing field above changes.
  cartItems   CartItem[]
  // SPEC-ORDER-001 M1 — back-relation only; no existing field above changes.
  // Its FK side is Restrict, deliberately unlike cartItems' Cascade, so a
  // product that has ever been ordered can no longer be deleted (design.md §1.2).
  orderItems  OrderItem[]

  @@index([categoryId]) // REQ-CATALOG-010 category filter
  @@index([createdAt]) // REQ-CATALOG-008 `newest` sort (the default)
  @@index([price]) // REQ-CATALOG-008 `price_asc` / `price_desc` sorts
  // SPEC-CATALOG-002 M1 — REQ-CATALOG-018 keyword search runs as
  // `name ILIKE '%term%'`. A B-tree index cannot serve a LEADING wildcard (it
  // can only seek a known prefix), so the three indexes above leave that scan
  // unaccelerated. A GIN index over trigrams can, which is what keeps a search
  // request inside REQ-CATALOG-016B's p95 300ms budget as the catalog grows.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_name_trgm_idx")
}

// ---------------------------------------------------------------------------
// SPEC-CART-001 M1 — cart domain.
//
// Source of truth for these two model shapes: SPEC-CART-001 plan.md §4. Do not
// diverge from plan.md without updating plan.md first (manager-develop is not
// the owner of SPEC body content).
// ---------------------------------------------------------------------------

// A cart belongs to EXACTLY ONE identity (REQ-CART-001): a member (`userId`)
// or a guest cookie (`guestId`). Both columns are nullable and the "exactly
// one" half is an APP-LEVEL invariant, not a DB CHECK constraint — plan.md
// §2.1 chose this over a polymorphic owner column (which forfeits the FK to
// User) and over split UserCart/GuestCart tables (which forces CartItem to
// point at two parents). The invariant is held by giving the repository only
// two construction paths, createUserCart() and createGuestCart(), so no code
// path exists that can fill both columns or neither.
//
// @MX:ANCHOR fan-in target — every cart read and write path reaches this
// model: identity resolution, the four public cart endpoints, and the
// login-time guest->member merge invoked from both auth success routes.
// @MX:REASON the ownership columns here are what separates one shopper's cart
// from another's, so a change to their nullability or uniqueness is an
// authorization boundary change, not a modelling detail.
model Cart {
  id        String     @id @default(cuid())
  // @unique on a NULLABLE column excludes NULLs from the uniqueness check
  // (standard Postgres), so these read as "at most one cart per member" and
  // "at most one cart per guest cookie" while still allowing many rows to
  // leave the other column NULL.
  userId    String?    @unique
  guestId   String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([guestId])
}

// One line of a cart. Carries NO price column: the cart always joins
// Product.price live (plan.md §2.4) because nothing has been promised to the
// shopper until checkout, and checkout owns its own price-confirmation
// mechanism.
model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  // Cascade, deliberately UNLIKE Product -> Category's Restrict: a cart line
  // has no reason to outlive the product it points at, so a deleted product
  // simply leaves every cart (plan.md §4/§8).
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The conflict target REQ-CART-006's add-is-increment upsert relies on: one
  // row per (cart, product) is what makes "add the same product again" an
  // increment rather than a duplicate row.
  @@unique([cartId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// SPEC-ORDER-001 M1 — order domain (GUEST checkout only).
//
// Source of truth for these two model shapes and the enum: SPEC-ORDER-001
// design.md §1. Do not diverge from design.md without updating design.md first
// (manager-develop is not the owner of SPEC body content).
//
// The scope boundary is enforced HERE rather than in prose: there is no
// `userId`, no `user` relation, and `guestId` is NOT NULL, so a member-owned
// order is not representable (design.md §1.4). Member checkout is excluded
// because a server-rendered page cannot identify a member at all — the access
// token lives only in client memory and the guest cookie is expired at login
// (spec.md §3, research.md §6).
// ---------------------------------------------------------------------------

enum OrderStatus {
  pending_payment // the ONLY status this SPEC ever writes (REQ-ORDER-017)
  paid // reserved for the follow-up payment SPEC — no transition exists here
  cancelled // reserved for the follow-up cancellation SPEC
}

// @MX:ANCHOR fan-in target — every order write in this SPEC reaches the
// database through the single transaction in order-service.ts, and both
// checkout screens read this model.
// @MX:REASON `guestId` is the whole authorization basis for reading an order
// back (REQ-ORDER-020), so a change to its nullability or to the absence of a
// member column is a scope-boundary change, not a modelling detail.
model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique // human-readable, quotable in enquiries (REQ-ORDER-003)
  status      OrderStatus @default(pending_payment)

  // The owning identity: the `guest_cart_id` value as of the order. NOT NULL,
  // and there is deliberately no member counterpart (design.md §1.4).
  guestId String

  // Shipping snapshot — exactly the five fields REQ-ORDER-008 permits. No
  // email, no payment instrument (REQ-ORDER-009).
  recipientName  String
  recipientPhone String
  postalCode     String
  address        String
  deliveryMemo   String?

  // Money snapshot, frozen at creation (REQ-ORDER-003).
  itemsSubtotal Int // sum of every OrderItem.lineTotal
  shippingFee   Int
  totalAmount   Int // itemsSubtotal + shippingFee

  // SPEC-DISCOUNT-001 M1 — coupon snapshot, NOT a foreign key. Same reasoning
  // as OrderItem.productName/unitPrice below: a join would give the CURRENT
  // coupon value, but the order needs the value the customer agreed to at
  // checkout, frozen even if the coupon is later edited or deleted
  // (REQ-DISCOUNT-014, design.md §1.2). `@default(0)`/nullable keep every
  // existing order row valid after migration — `discountAmount = 0` and
  // `couponCode = null` together mean "no coupon applied" (REQ-DISCOUNT-019).
  couponCode     String? // uppercase-normalized copy of the applied code, or null
  discountAmount Int     @default(0) // amount already subtracted into totalAmount above

  // Second line of defence for REQ-ORDER-016: two concurrent submissions that
  // both pass the pre-transaction lookup are serialised by this constraint.
  idempotencyKey String @unique

  // SPEC-PAYMENT-001 M1 — the only column this SPEC adds to Order. Attributes
  // this order to at most one PG payment (REQ-PAYMENT-004); set by whichever
  // trigger (confirm API or webhook) first confirms the order, and read back
  // to reject an event carrying a different paymentKey (design.md §1).
  paymentKey String? @unique

  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // SPEC-PAYMENT-001 M1 — back-relation only; no existing field above changes.
  auditLogs PaymentAuditLog[]

  @@index([guestId])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  // Restrict, deliberately UNLIKE CartItem.product's Cascade: an order line is
  // an accounting record and must not be destroyed by a product deletion
  // (design.md §1.2).
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  // Snapshot of the product AS OF the order (REQ-ORDER-002). Joining Product
  // would give the CURRENT values; an order needs the ones the shopper agreed
  // to. `lineTotal` is stored rather than recomputed so a later change to the
  // pricing arithmetic cannot move a past order's figures (design.md §1.1).
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// SPEC-PAYMENT-001 M1 — payment domain (PG confirm + webhook, guest orders
// only). Source of truth for this enum and model: SPEC-PAYMENT-001 design.md
// §1. Do not diverge from design.md without updating design.md first
// (manager-develop is not the owner of SPEC body content).
//
// This SPEC adds exactly one column to Order (paymentKey, above) and this one
// new table. OrderStatus is unchanged — `paid`/`cancelled` were already
// reserved by SPEC-ORDER-001; this SPEC is the first to transition into them.
// ---------------------------------------------------------------------------

enum PaymentEventSource {
  CONFIRM_API // success redirect -> confirm API call path
  WEBHOOK // PAYMENT_STATUS_CHANGED webhook path
}

// @MX:ANCHOR fan-in target — every payment state transition in this SPEC
// writes exactly one row here (REQ-PAYMENT-001). payment-repository.ts is the
// ONLY writer, and it exports create only — never update/delete (design.md
// §1.2, REQ-PAYMENT-002 append-only).
// @MX:REASON the append-only invariant is enforced at the application layer
// (no update/delete export), not by a DB trigger — a schema reader must know
// this model's immutability is a code-level contract, not a DB-level one.
model PaymentAuditLog {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  source         PaymentEventSource
  previousStatus OrderStatus
  newStatus      OrderStatus
  paymentKey     String?

  // Second line of idempotency defence (design.md §3). confirm-path events
  // carry no transmission id, so this stays null for those rows.
  transmissionId String? @unique

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// SPEC-DISCOUNT-001 M1 — coupon/discount domain (guest orders only). Source
// of truth for this enum and model: SPEC-DISCOUNT-001 design.md §1. Do not
// diverge from design.md without updating design.md first (manager-develop is
// not the owner of SPEC body content).
//
// This SPEC adds exactly one new table (Coupon, below) and two columns to
// Order (couponCode/discountAmount, above). No other existing model changes.
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENTAGE // value = percent, 0 < value <= 100 (REQ-DISCOUNT-003)
  FIXED_AMOUNT // value = won
}

model Coupon {
  id String @id @default(cuid())

  // Stored uppercase-normalized (REQ-DISCOUNT-002). The application layer
  // uppercases before every read and write, so a case-sensitive unique index
  // is sufficient — no citext extension needed (the only extension already in
  // use is pg_trgm, for a different SPEC's search index; design.md §1.1).
  code           String       @unique
  type           DiscountType
  value          Int
  minOrderAmount Int          @default(0)

  // GLOBAL cap, NOT a per-guest/per-user limit — this repository has no
  // reliable per-guest identity to enforce against (REQ-DISCOUNT-022,
  // spec.md §3 Out of Scope — 인별 사용 제한). "Global" here means: this
  // number is the total redemptions of this code across every order, ever.
  maxRedemptions Int
  // @MX:ANCHOR this column is written ONLY via the conditional atomic update
  // in coupon-repository.ts (design.md §3.2) — `updateMany` with a
  // `redeemedCount < maxRedemptions` WHERE clause, never a plain read-then-
  // write.
  // @MX:REASON a plain read-then-write races: two concurrent orders reading
  // the same redeemedCount can both pass validation and both increment,
  // silently exceeding maxRedemptions (REQ-DISCOUNT-016).
  redeemedCount Int @default(0)

  startsAt DateTime
  endsAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Deliberately no relation to Order — Order.couponCode is a snapshot copy,
  // not a foreign key (see the Order model comment above, and OrderItem's
  // productName/unitPrice for the established precedent).
  @@index([code])
}
