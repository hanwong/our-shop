# --- Database ---
# PostgreSQL connection string (see prisma/schema.prisma datasource).
DATABASE_URL="postgresql://user:password@localhost:5432/our_shop?schema=public"

# --- JWT / Session (SPEC-AUTH-001 §3.4) ---
# Access-token signing secret. Server-only — never expose with NEXT_PUBLIC_ prefix.
JWT_ACCESS_SECRET=""
# Access-token expiry (default 15m). Format: a duration string consumed by jose (e.g. "15m").
JWT_ACCESS_TOKEN_EXPIRY="15m"
# Refresh-token expiry (default 30d). Refresh tokens are opaque random strings, not signed
# JWTs, so no JWT_REFRESH_SECRET is needed (see plan.md §3.2 design decision).
JWT_REFRESH_TOKEN_EXPIRY="30d"

# --- Google OAuth (SPEC-AUTH-001 §3.3) ---
GOOGLE_CLIENT_ID=""
# Server-only — never expose with NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# --- Cookies ---
# Cookie domain; Secure attribute is derived from NODE_ENV at runtime.
COOKIE_DOMAIN="localhost"

# --- Toss Payments (SPEC-PAYMENT-001 §0#7) ---
# Basic-auth secret for the confirm(승인) API AND the Payment Query API (used
# to re-verify a webhook's claimed payment — PAYMENT_STATUS_CHANGED carries
# no signature header, so Toss's own Payment Query API is the verification
# path instead; addresses CodeRabbit PR #9 review). Server-only — never
# expose with NEXT_PUBLIC_ prefix.
PG_SECRET_KEY=""
# Browser SDK client key. Public by design — Toss's client key is meant to be exposed
# (plan.md §0#7 renamed this away from tech.md's PG_API_KEY, whose name implied server-only).
NEXT_PUBLIC_PG_CLIENT_KEY=""

# --- Runtime ---
NODE_ENV="development"
